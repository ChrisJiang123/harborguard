# HarborGuard local LoRA model (C4).
# Place harborguard.gguf exported by train_lora.ipynb in this directory,
# then run from ml/lora/:
#   ollama create harborguard-lora -f Modelfile
#   ollama run harborguard-lora "Hello"  # Smoke test.
#   python -m ml.lora.eval  # Paired base/LoRA evaluation -> metrics.json.
# System prompts are supplied in Agent requests, matching distillation training.
FROM ./harborguard.gguf
PARAMETER temperature 0.2
