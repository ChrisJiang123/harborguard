# ============================================================================
# HarborGuard C environment example
# Usage: cp .env.example .env, then fill credentials locally.
# .env is ignored by Git and must never be committed.
# All model names, API URLs and backend addresses are configured here;
# agent/config.py explicitly loads dotenv; existing process values take priority.
# ============================================================================

# Cloud LLM: explicitly select a provider; never infer from credentials.
# Values: openrouter / anthropic / disabled. The recorded local acceptance used openrouter.
CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fixed model ID; auto or random routing is prohibited.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_S=15

# Legacy Anthropic-compatible adapter: read only when CLOUD_PROVIDER=anthropic.
# Protocol compatibility does not prove upstream identity; OpenRouter ignores these credentials.
ANTHROPIC_API_KEY=
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_S=15

# B backend.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000/ws
BACKEND_TIMEOUT_S=5

# Agent service.
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# Recommendation and answer language: en (default) or zh.
AGENT_LANG=en
# Total options_ready-to-recommendation POST budget; reserve 0.5s for template/POST.
AGENT_EVENT_BUDGET_S=9.5
AGENT_POST_RESERVE_S=0.5
# Cloud uses at most 4s; preserve remaining time for the local route.
AGENT_CLOUD_BUDGET_S=4
# B /api/agent/ask proxy timeout is 20s.
AGENT_ASK_BUDGET_S=18
# Redacted fact-check failures; agent/runtime/ is ignored.
AGENT_FAILURE_LOG=agent/runtime/fact_failures.jsonl

# Local Ollama: /v1 config root; Agent calls native /api/chat from the same root.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b
# Contract local timeout: 30s.
OLLAMA_TIMEOUT_S=30
OLLAMA_KEEP_ALIVE=30m
# Explicit model output overrides, comma-separated model:json|schema (C4 candidate).
# Empty/unset keeps complete schemas for every model; clear this variable to roll back.
# Example: OLLAMA_FORMAT_OVERRIDES=harborguard-lora:json,harborguard-base:json
OLLAMA_FORMAT_OVERRIDES=
