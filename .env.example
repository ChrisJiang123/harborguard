# ============================================================================
# HarborGuard C · 环境配置示例
# 用法: cp .env.example .env  然后填写密钥
# .env 已被 .gitignore 忽略，绝不提交。
# 所有模型名 / API 地址 / 后端地址均通过本文件配置；
# 运行时由 agent/config.py 显式 load_dotenv() 读取（已存在的进程环境变量优先）。
# ============================================================================

# ---- 云端 LLM（必须显式选择，不根据任何凭据自动推断） ----
# 可选值：openrouter / anthropic / disabled。本机验收使用 openrouter。
CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 固定模型 ID；禁止使用 auto 或随机路由模型。
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_S=15

# ---- 旧 Anthropic 兼容适配（保留；仅 CLOUD_PROVIDER=anthropic 时读取） ----
# 协议兼容不代表实际服务是 Anthropic Claude。OpenRouter 模式不会读取这些凭据。
ANTHROPIC_API_KEY=
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_S=15

# ---- B 的后端 ----
BACKEND_BASE_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000/ws
BACKEND_TIMEOUT_S=5

# ---- Agent 服务自身 ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# options_ready 到建议 POST 的总预算；给最终模板与 POST 预留 0.5 秒
AGENT_EVENT_BUDGET_S=9.5
AGENT_POST_RESERVE_S=0.5
# 云端最多占总预算的 4 秒；失败后的剩余时间留给本地
AGENT_CLOUD_BUDGET_S=4
# 后端 /api/agent/ask 的代理超时为 20 秒
AGENT_ASK_BUDGET_S=18
# 脱敏事实校验失败样例；agent/runtime/ 已被 gitignore
AGENT_FAILURE_LOG=agent/runtime/fact_failures.jsonl

# ---- 本地 LLM (Ollama；/v1 地址用于配置，Agent 从同一根地址调用原生 /api/chat) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b
# 契约：本地超时 30 秒
OLLAMA_TIMEOUT_S=30
OLLAMA_KEEP_ALIVE=30m
