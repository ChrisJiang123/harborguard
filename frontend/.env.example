VITE_WS_URL=ws://localhost:8000/ws
VITE_API_BASE=http://localhost:8000/api
VITE_BATHYMETRY_URL=/data/seabed-dem.json

# Vercel Preview/Production: replace both addresses with the same Mac backend tunnel.
# VITE_API_BASE=https://your-backend.example.com/api
# VITE_WS_URL=wss://your-backend.example.com/ws
# These public values are baked into the build. Redeploy after changing the tunnel.
# Never put OpenRouter/Ollama credentials or tunnel tokens in VITE_* variables.
