# ============ HarborGuard .gitignore (maintained by C) ============
# Keep secrets, virtual environments, datasets, training logs and large models out of Git.

# ---- Credentials and local configuration ----
.env
.env.*
!.env.example

# ---- Separate virtual environments for runtime, YOLO and LoRA training ----
.venv/
.venv-*/

# ---- Large reproducible datasets: synthetic sonar and distilled examples ----
ml/datasets/
ml/lora/datasets/
data/cache/

# ---- Training logs and output ----
runs/
wandb/
*.log
logs/
agent/runtime/

# ---- Large model files: weights, GGUF and checkpoints ----
# Exception: the delivered nano weights ml/yolo/weights/best.pt may be committed.
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
!ml/yolo/weights/best.pt
!ml/yolo/weights/.gitkeep

# ---- Download caches, including official weights fetched by check_c0 ----
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE and operating system ----
.idea/
.vscode/
.DS_Store

# B backend development and local verification
node_modules/
dist/
dist-ssr/
frontend/work/
coverage/
*.tsbuildinfo
recordings/
*.webm
*.mp4
.coverage
artifacts/
.tools/
